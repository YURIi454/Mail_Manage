# Секретный ключ Django
SECRET_KEY=секретный-ключ-django

# Режим отладки: True/False
DEBUG=False

# Список разрешённых хостов через запятую
HOST_NAME=localhost,127.0.0.1

# Подключение к базе данных PostgreSQL
NAME=
USER=
PASSWORD=
HOST=
PORT=

# Адрес подключения к серверу Redis (используется при CACHE_BACKEND = RedisCache)
REDIS_LOCATION=redis://127.0.0.1:6379/1

# Бэкенд кеша Django
# Redis:    django.core.cache.backends.redis.RedisCache
# В памяти: django.core.cache.backends.locmem.LocMemCache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Почтовый аккаунт для отправки писем
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Обертывать каждый запрос в атомарную транзакцию: True/False
ATOMIC_REQUESTS=False
